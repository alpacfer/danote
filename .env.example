DANOTE_TRANSLATION_PROVIDER=deepl
DANOTE_TRANSLATION_DEEPL_API_KEY=
DANOTE_TRANSLATION_DEEPL_ENDPOINT=

# Optional Azure translation provider config when DANOTE_TRANSLATION_PROVIDER=azure
DANOTE_TRANSLATION_AZURE_API_KEY=
DANOTE_TRANSLATION_AZURE_REGION=
DANOTE_TRANSLATION_AZURE_ENDPOINT=
DANOTE_TRANSLATION_AZURE_API_VERSION=3.0

DANOTE_TTS_PROVIDER=azure
DANOTE_TTS_AZURE_API_KEY=
DANOTE_TTS_AZURE_REGION=
DANOTE_TTS_AZURE_ENDPOINT=
DANOTE_TTS_AZURE_VOICE_NAME=da-DK-ChristelNeural

# Kept for word verification only.
DANOTE_WORD_VERIFICATION_GEMINI_API_KEY=

# Optional: where to append JSONL audit entries for "Apply Gemini changes".
DANOTE_GEMINI_CHANGES_LOG_PATH=backend/data/gemini-applied-changes.jsonl

# Optional: local COR sqlite database used by command search.
DANOTE_COR_LOCAL_DB_PATH=backend/resources/dictionaries/cor.sqlite
